ANTHROPIC_API_KEY=your-anthropic-key-here
MODEL=claude-sonnet-5
# Secret that callers (your Base44 app) must send in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=your-service-key-here
RATE_LIMIT_PER_HOUR=20
# Comma-separated browser origins allowed to call the API (leave blank if only called server-side)
ALLOWED_ORIGINS=
